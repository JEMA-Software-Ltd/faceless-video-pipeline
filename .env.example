# Copy to .env and fill in. .env is gitignored — never commit real keys.
# doctor.py checks that each of these (except FONT_PATH, unless captions are
# enabled) is present and non-empty.

# --- Gemini (keyword extraction in script.py) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Stock imagery ---
# Pexels (primary):  https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay (fallback): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- YouTube Data API v3 (upload.py) ---
# Create an OAuth 2.0 "Desktop app" client in Google Cloud Console, enable the
# YouTube Data API v3, then run the one-off consent flow (see README) to obtain
# a refresh token. upload.py exchanges the refresh token for access tokens and
# caches them to token.json (gitignored).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Fonts (only needed if captions.enabled: true in config.yaml) ---
# Absolute path to a .ttf/.otf. drawtext is fussy about relative paths.
# e.g. /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_PATH=
