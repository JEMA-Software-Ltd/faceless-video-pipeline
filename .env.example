# Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored — never commit real keys. Every value below is an empty
# placeholder. `python doctor.py` checks that each key is present and non-empty
# (except FONT_PATH, which is only required when captions.enabled is true).

# --- Gemini: visual keyword extraction (script.py) -------------------------
# What it does: for each paragraph of your script, asks Gemini for a few
#   concrete stock-photo search terms ("courtroom interior", "london skyline").
# Where to get it: https://aistudio.google.com/apikey  (free tier is plenty —
#   the pipeline makes ONE batched call per video).
# If missing or failing: script.py logs the error and falls back to a crude
#   offline heuristic. The video still renders, but image relevance drops
#   noticeably. See "Known limitations" in the README.
GEMINI_API_KEY=

# --- Stock imagery (images.py) ---------------------------------------------
# Pexels is primary, Pixabay is the fallback when Pexels returns too few hits.
# Both are free and both are used via their official search APIs — no scraping.
# Pexels:  https://www.pexels.com/api/          (25,000 requests/hour)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- YouTube Data API v3 (upload.py) ---------------------------------------
# Setup, in order:
#   1. Google Cloud Console -> create/select a project.
#   2. Enable "YouTube Data API v3".
#   3. Credentials -> Create Credentials -> OAuth client ID -> Desktop app.
#      Copy the client ID and secret into the two variables below. (You can
#      also download client_secret.json, but this pipeline does not read it —
#      it is gitignored precisely so it never lands in a commit.)
#   4. Run `python get_token.py` for the one-off browser consent flow. It
#      prints a refresh token; paste it into YOUTUBE_REFRESH_TOKEN below.
#
# IMPORTANT: the Google account you consent with must already have a YouTube
# channel. If it does not, uploads fail with HTTP 401 "youtubeSignupRequired" —
# the OAuth is fine, there is simply no channel to upload to. Sign in at
# youtube.com and create the channel first.
#
# upload.py exchanges the refresh token for access tokens and caches them in
# token.json (gitignored). The requested scope is youtube.upload only.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Fonts (only if captions.enabled: true in config.yaml) -----------------
# ABSOLUTE path to a .ttf/.otf file. ffmpeg's drawtext filter rejects relative
# paths. On Windows use forward slashes, e.g. C:/Windows/Fonts/arial.ttf
# On Linux, e.g. /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_PATH=
